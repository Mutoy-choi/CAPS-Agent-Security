# Optional project-scoped Codex MCP configuration.
# Copy to .codex/config.toml only after installing CAPS Verify and replacing the command path.

[mcp_servers.caps_unlock]
command = "/absolute/path/to/caps-verify-mcp"
args = ["--state", ".caps/fixture-state.json"]
startup_timeout_sec = 20
tool_timeout_sec = 120
