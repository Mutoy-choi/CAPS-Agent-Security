# Provider used by the bundled CAPS Runtime. OpenRouter is the lowest-friction default.
CAPS_PROVIDER=openrouter
CAPS_UPSTREAM_BASE_URL=https://openrouter.ai
CAPS_APP_RUNTIME_BASE_URL=http://caps-runtime:8788/api/v1
CAPS_UPSTREAM_API_KEY=replace-me
CAPS_EVALUATION_API_KEY=replace-me
CAPS_APP_MODEL=openai/gpt-4o-mini

# Generate independent random values for every secret before public deployment.
CAPS_APP_SECRET=replace-with-at-least-32-random-characters
CAPS_APP_ENCRYPTION_SECRET=replace-with-another-32-random-characters
CAPS_APP_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CAPS_GATEWAY_CLIENT_TOKEN=replace-with-a-long-random-gateway-token
CAPS_FINGERPRINT_SECRET=replace-with-a-long-random-fingerprint-secret

CAPS_APP_PUBLIC_NAME="CAPS Research Chat"
CAPS_APP_RESEARCH_TERMS_VERSION=caps-research-v1
CAPS_APP_RESEARCH_RETENTION_DAYS=365
CAPS_APP_SECURE_COOKIE=false
CAPS_APP_ALLOW_INSECURE_DEV=false
CAPS_APP_PORT=8000

# Optional custom attack pack for the synthetic shadow evaluator.
CAPS_ATTACK_PACK=
